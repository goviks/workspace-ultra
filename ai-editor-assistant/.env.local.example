# Скопируйте этот файл в .env.local и заполните значения.
# Ключ живёт ТОЛЬКО на сервере: он читается в app/api/ai/route.ts
# и никогда не попадает в клиентский бандл.

# Обязательно для реального ответа модели (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Необязательно: модель и лимиты
OPENAI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARS=6000
AI_REQUEST_TIMEOUT_MS=45000

# Демо-режим без ключа: стримит заранее заготовленный текст.
# Удобно для портфолио и для проверки UI без затрат на API.
# AI_MOCK=1
