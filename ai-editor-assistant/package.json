{
  "name": "ai-editor-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:stream": "node --experimental-strip-types scripts/verify-stream.mjs",
    "e2e": "node scripts/e2e-local.mjs",
    "screenshots": "node scripts/capture-states.mjs",
    "lighthouse": "lighthouse http://localhost:3000 --only-categories=performance,accessibility,best-practices,seo --output=json --output=html --output-path=docs/lighthouse --chrome-flags=\"--headless=new --no-sandbox\" --quiet"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
